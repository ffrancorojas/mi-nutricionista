{
  "name": "mi-nutricionista",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names client,server --prefix-colors cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "typecheck:server": "npm --prefix server run typecheck",
    "lint:client": "npm --prefix client run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.6.2"
  }
}
